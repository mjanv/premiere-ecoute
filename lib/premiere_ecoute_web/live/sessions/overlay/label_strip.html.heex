<div style={"width: #{@width}; flex-shrink: 0; display: flex; flex-direction: column; background: #000000; color: #{@color}; border: 1.5vh solid #{@color}; box-sizing: border-box; overflow: hidden;"}>
  <div style="flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; overflow: hidden;">
    <svg
      id={"label-#{@score}"}
      phx-hook="FitSvgText"
      data-fill="0.94"
      viewBox={"0 0 100 #{label_length(@user, @score) + 10}"}
      preserveAspectRatio="xMidYMid meet"
      style="width: 100%; height: 100%; display: block;"
      aria-label={score_label(@user, @score)}
    >
      <g>
        <text
          transform={"translate(90 #{label_length(@user, @score) + 5}) rotate(-90)"}
          textLength={label_length(@user, @score)}
          lengthAdjust="spacingAndGlyphs"
          font-size="100"
          font-family="Overlay"
          font-weight="700"
          fill="currentColor"
        >
          {label_text(@user, @score)}
        </text>
      </g>
    </svg>
  </div>
  <div
    :if={@counter}
    style={"height: calc(#{bar_height()} - 1.5vh); display: flex; align-items: center; justify-content: center; background: #{@color}; color: #000000; font-family: Overlay; font-weight: 700; -webkit-text-stroke: 0.3vh #000000; font-size: 12.5vh; line-height: 1; white-space: nowrap;"}
  >
    {track_counter(@progress)}
  </div>
</div>
