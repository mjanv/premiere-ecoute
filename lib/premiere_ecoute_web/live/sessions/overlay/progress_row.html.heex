<div style={"height: #{bar_height()}; flex-shrink: 0; box-sizing: border-box; border: 1.5vh solid #{@color}; border-left: 0; border-top: 0; background: linear-gradient(to right, #{bar_played_color(@widget_state, @color, @secondary)} 0%, #{bar_played_color(@widget_state, @color, @secondary)} #{@percent}%, #{bar_remaining_color(@widget_state, @color, @secondary)} #{@percent}%, #{bar_remaining_color(@widget_state, @color, @secondary)} 100%);"}>
</div>
