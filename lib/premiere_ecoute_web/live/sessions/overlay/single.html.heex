<div style="display: flex; flex-direction: row; width: 100%; height: 100%; box-sizing: border-box;">
  <!-- Vertical label + track counter -->
  <div style={"width: 17%; flex-shrink: 0; display: flex; flex-direction: column; background: #000000; color: #{@color}; border: 1.5vh solid #{@color}; box-sizing: border-box; overflow: hidden;"}>
    <div style="flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center;">
      <span style={"writing-mode: vertical-rl; transform: rotate(180deg); font-family: Impact, 'Arial Black', sans-serif; font-weight: 900; -webkit-text-stroke: 0.8vh #{@color}; font-size: #{label_size(@score)}; line-height: 1; text-transform: uppercase; letter-spacing: 0.02em; white-space: nowrap;"}>
        {score_label(@user, @score)}
      </span>
    </div>
    <div style={"height: calc(#{@bar_height} - 1.5vh); display: flex; align-items: center; justify-content: center; background: #{@color}; color: #000000; font-family: Impact, 'Arial Black', sans-serif; font-weight: 900; font-size: 9vh; -webkit-text-stroke: 0.25vh #000000; line-height: 1; white-space: nowrap;"}>
      {track_counter(@progress)}
    </div>
  </div>

  <!-- Score -->
  <div style="flex: 1; min-width: 0; display: flex; flex-direction: column;">
    <div style={"flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1.5vh solid #{@color}; border-left: 0; border-bottom: 0;"}>
      <.async_result :let={summary} assign={@summary}>
        <:loading>
          <span style={"font-size: 60vh; font-weight: 900; color: #{@text_color}; text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);"}>
            --
          </span>
        </:loading>

        <%= if @widget_state == :closed do %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill={@text_color}
            aria-hidden="true"
            style="width: 50vh; height: 50vh;"
          >
            <path
              fill-rule="evenodd"
              d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z"
              clip-rule="evenodd"
            />
          </svg>
        <% else %>
          <%= if @widget_state == :open and score_nil?(summary, @score) do %>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill={@text_color}
              aria-hidden="true"
              style="width: 50vh; height: 50vh;"
            >
              <path d="M18 1.5c2.9 0 5.25 2.35 5.25 5.25v3.75a.75.75 0 0 1-1.5 0V6.75a3.75 3.75 0 1 0-7.5 0v3a3 3 0 0 1 3 3v6.75a3 3 0 0 1-3 3H3.75a3 3 0 0 1-3-3v-6.75a3 3 0 0 1 3-3h9v-3c0-2.9 2.35-5.25 5.25-5.25Z" />
            </svg>
          <% else %>
            <span style={"font-size: 60vh; font-weight: 900; color: #{@text_color}; text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);"}>
              {score_value(summary, @score)}
            </span>
          <% end %>
        <% end %>
      </.async_result>
    </div>
    <!-- Progress bar -->
    <div style={"height: #{@bar_height}; flex-shrink: 0; box-sizing: border-box; border: 1.5vh solid #{@color}; border-left: 0; border-top: 0; background: linear-gradient(to right, #{@bar_played} 0%, #{@bar_played} #{@percent}%, #{@bar_remaining} #{@percent}%, #{@bar_remaining} 100%);"}>
    </div>
  </div>
</div>
