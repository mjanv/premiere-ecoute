<div style="display: flex; flex-direction: row; width: 100%; height: 100%; box-sizing: border-box;">
  <.label_strip score={@score} user={@user} color={@color} progress={@progress} counter={true} width="28vh" />

  <div style="flex: 1; min-width: 0; display: flex; flex-direction: column;">
    <.score_box
      summary={@summary}
      score={@score}
      widget_state={@widget_state}
      text_color={@text_color}
      color={@color}
      font="60vh"
      icon="50vh"
      last={true}
    />
    <.progress_row percent={@percent} color={@color} secondary={@secondary} widget_state={@widget_state} />
  </div>
</div>
