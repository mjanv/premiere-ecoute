<div style={"background: #{widget_bg(@widget_state, @color_primary, @color_secondary)}; border-radius: 0px; #{overlay_size(@score)}display: flex; align-items: center; justify-content: center; color: #{widget_text_color(@widget_state, @color_primary, @color_secondary)}; line-height: 1; position: relative;"}>
  <%= if @score in [:player] do %>
    <.player
      progress={@progress}
      summary={@summary}
      widget_state={@widget_state}
      score={@score}
      user={@user}
      text_color={widget_text_color(@widget_state, @color_primary, @color_secondary)}
    />
  <% end %>
  <%= if @score in [:viewer, :streamer] do %>
    <.single
      summary={@summary}
      progress={@progress}
      percent={@percent}
      color={@color_primary}
      bar_height="12vh"
      bar_played={bar_played_color(@widget_state, @color_primary, @color_secondary)}
      bar_remaining="#d4d4cc"
      bg_color={widget_bg(@widget_state, @color_primary, @color_secondary)}
      widget_state={@widget_state}
      score={@score}
      user={@user}
      text_color={widget_text_color(@widget_state, @color_primary, @color_secondary)}
    />
  <% end %>
  <%= if @score in [:both] do %>
    <.double
      summary={@summary}
      widget_state={@widget_state}
      score={@score}
      user={@user}
      text_color={widget_text_color(@widget_state, @color_primary, @color_secondary)}
    />
  <% end %>
  <%= if @score in [:votes] do %>
    <.vote_bar
      vote_distribution={@vote_distribution}
      widget_state={@widget_state}
      score={@score}
      text_color={widget_text_color(@widget_state, @color_primary, @color_secondary)}
    />
  <% end %>
  <%= if @score not in [:votes, :viewer, :streamer] do %>
    <div style={"position: absolute; bottom: 0; left: 0; width: 100%; height: #{progress_bar_height(@score)}; background: linear-gradient(to right, #{bar_played_color(@widget_state, @color_primary, @color_secondary)} 0%, #{bar_played_color(@widget_state, @color_primary, @color_secondary)} #{@percent}%, #{bar_remaining_color(@widget_state, @color_primary, @color_secondary)} #{@percent}%, #{bar_remaining_color(@widget_state, @color_primary, @color_secondary)} 100%);"}>
    </div>
  <% end %>
</div>
