<PremiereEcouteWeb.Components.Header.app_header current_user={@current_scope.user} current_scope={@current_scope} />
<div class="bg-gray-900 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <PremiereEcouteWeb.Admin.AdminComponents.admin_page_header
      title={gettext("Wrapped")}
      subtitle={gettext("Viewer recaps computed for a year")}
    />

    <div class="flex flex-wrap items-center gap-3 mb-6">
      <div class="flex gap-1">
        <.link
          :for={year <- @years}
          patch={~p"/admin/wrapped?year=#{year}"}
          class={[
            "px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
            if(year == @year,
              do: "bg-purple-500 text-white",
              else: "bg-gray-800 text-gray-400 hover:text-white border border-gray-700"
            )
          ]}
        >
          {year}
        </.link>
      </div>
      <div class="flex gap-3 sm:ml-auto">
        <.button id="refresh" variant="outline" phx-click="refresh">{gettext("Refresh")}</.button>
        <.button
          id="compute-all"
          variant="primary"
          phx-click="compute_all"
          data-confirm={gettext("Compute the Wrapped of every eligible viewer of %{year}?", year: @year)}
        >
          {gettext("Compute all")}
        </.button>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
      <PremiereEcouteWeb.Admin.AdminComponents.stat_card value={@eligible} label={gettext("Voters")} color="blue">
        <:icon><.icon name="hero-users" class="w-6 h-6 text-blue-300" /></:icon>
      </PremiereEcouteWeb.Admin.AdminComponents.stat_card>
      <PremiereEcouteWeb.Admin.AdminComponents.stat_card value={@stats.total} label={gettext("Recaps")} color="green">
        <:icon><.icon name="hero-sparkles" class="w-6 h-6 text-green-300" /></:icon>
      </PremiereEcouteWeb.Admin.AdminComponents.stat_card>
      <PremiereEcouteWeb.Admin.AdminComponents.stat_card
        value={@stats.empty}
        label={gettext("Without cards")}
        color="yellow"
      >
        <:icon><.icon name="hero-no-symbol" class="w-6 h-6 text-yellow-300" /></:icon>
      </PremiereEcouteWeb.Admin.AdminComponents.stat_card>
      <PremiereEcouteWeb.Admin.AdminComponents.stat_card
        value={@stats.outdated}
        label={gettext("Outdated")}
        color="red"
      >
        <:icon><.icon name="hero-exclamation-triangle" class="w-6 h-6 text-red-300" /></:icon>
      </PremiereEcouteWeb.Admin.AdminComponents.stat_card>
      <PremiereEcouteWeb.Admin.AdminComponents.stat_card value={@pending} label={gettext("Jobs pending")} color="purple">
        <:icon><.icon name="hero-clock" class="w-6 h-6 text-purple-300" /></:icon>
      </PremiereEcouteWeb.Admin.AdminComponents.stat_card>
    </div>

    <PremiereEcouteWeb.Admin.AdminComponents.search_bar value={@search} placeholder={gettext("Search by username…")} />

    <div class="bg-gray-800 rounded-lg shadow">
      <div class="px-6 py-4 border-b border-gray-700">
        <h2 class="text-xl font-semibold text-white">{gettext("Recaps")} ({@page.total_entries})</h2>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-700">
          <thead class="bg-gray-700">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                {gettext("User")}
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                {gettext("Cards")}
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                {gettext("Version")}
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                {gettext("Computed")}
              </th>
              <th class="px-6 py-3"></th>
            </tr>
          </thead>
          <tbody class="bg-gray-800 divide-y divide-gray-700">
            <tr :for={recap <- @page.entries} id={"recap-#{recap.id}"} class="hover:bg-gray-700">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-white">
                <.link navigate={~p"/admin/users/#{recap.user_id}"} class="hover:text-purple-400">
                  {recap.user.username}
                </.link>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">{length(recap.cards)}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <span class={[
                  "badge badge-sm",
                  if(recap.version == Wrapped.version(), do: "badge-ghost", else: "badge-warning")
                ]}>
                  v{recap.version}
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
                {Calendar.strftime(recap.computed_at, "%Y-%m-%d %H:%M")}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <.link
                  navigate={~p"/admin/wrapped/#{recap.year}/#{recap.id}"}
                  class="text-gray-400 hover:text-white mr-4"
                >
                  {gettext("Open")}
                </.link>
                <.button size="xs" variant="outline" phx-click="recompute" phx-value-id={recap.user_id}>
                  {gettext("Recompute")}
                </.button>
                <.button
                  size="xs"
                  variant="danger"
                  class="ml-2"
                  phx-click="delete"
                  phx-value-id={recap.id}
                  data-confirm={gettext("Delete the Wrapped of %{user}?", user: recap.user.username)}
                >
                  {gettext("Delete")}
                </.button>
              </td>
            </tr>
            <tr :if={@page.entries == []}>
              <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">{gettext("No recap yet")}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-center space-x-1">
      <%= for page_item <- pagination_range(@page.page_number, @page.total_pages) do %>
        <%= if page_item == :ellipsis do %>
          <span class="px-2 py-1 text-sm text-gray-500">...</span>
        <% else %>
          <%= if page_item == @page.page_number do %>
            <span class="px-3 py-1 text-sm font-medium text-white bg-purple-500 rounded border border-purple-500">
              {page_item}
            </span>
          <% else %>
            <.link
              patch={~p"/admin/wrapped?year=#{@year}&page=#{page_item}"}
              class="px-3 py-1 text-sm text-gray-400 hover:text-purple-400 hover:bg-gray-800 rounded transition-colors"
            >
              {page_item}
            </.link>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
